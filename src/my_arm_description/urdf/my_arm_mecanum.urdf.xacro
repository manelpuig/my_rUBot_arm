<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="my_arm">

  <xacro:arg name="ros2_control_params" default=""/>
  <xacro:arg name="hardware_plugin" default="fake_components/GenericSystem"/>
  <xacro:arg name="use_gazebo_plugin" default="false"/>

  <!-- Approximate SG90 wooden arm dimensions -->
  <xacro:arg name="base_z" default="0.030"/>
  <xacro:arg name="base_x" default="0.100"/>
  <xacro:arg name="base_y" default="0.100"/>

  <xacro:arg name="L1" default="0.055"/>  <!-- base to shoulder height -->
  <xacro:arg name="L2" default="0.075"/>  <!-- upper arm -->
  <xacro:arg name="L3" default="0.075"/>  <!-- forearm -->
  <xacro:arg name="L4" default="0.045"/>  <!-- wrist / gripper support -->
  <xacro:arg name="tool_x" default="0.050"/>

  <xacro:arg name="r_link" default="0.012"/>

  <xacro:property name="L1" value="$(arg L1)"/>
  <xacro:property name="L2" value="$(arg L2)"/>
  <xacro:property name="L3" value="$(arg L3)"/>
  <xacro:property name="L4" value="$(arg L4)"/>
  <xacro:property name="r" value="$(arg r_link)"/>

  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="wood"><color rgba="0.70 0.45 0.20 1"/></material>
  <material name="blue"><color rgba="0.2 0.3 0.8 1"/></material>
  <material name="red"><color rgba="0.8 0.2 0.2 1"/></material>

  <xacro:macro name="inertial_box" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${mass*(y*y+z*z)/12.0}" ixy="0" ixz="0"
               iyy="${mass*(x*x+z*z)/12.0}" iyz="0"
               izz="${mass*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_cylinder_x" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${mass*radius*radius/2.0}" ixy="0" ixz="0"
               iyy="${mass*(3*radius*radius+length*length)/12.0}" iyz="0"
               izz="${mass*(3*radius*radius+length*length)/12.0}"/>
    </inertial>
  </xacro:macro>

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${$(arg base_z)/2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="$(arg base_x) $(arg base_y) $(arg base_z)"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${$(arg base_z)/2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="$(arg base_x) $(arg base_y) $(arg base_z)"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.2" x="$(arg base_x)" y="$(arg base_y)" z="$(arg base_z)"/>
  </link>

  <!-- Vertical base column -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 ${L1/2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${r}" length="${L1}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${L1/2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${r}" length="${L1}"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.05" x="0.02" y="0.02" z="${L1}"/>
  </link>

  <!-- Upper arm along +X -->
  <link name="link2">
    <visual>
      <origin xyz="${L2/2.0} 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="${r}" length="${L2}"/>
      </geometry>
      <material name="wood"/>
    </visual>
    <collision>
      <origin xyz="${L2/2.0} 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="${r}" length="${L2}"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder_x mass="0.05" radius="${r}" length="${L2}"/>
  </link>

  <!-- Forearm along +X -->
  <link name="link3">
    <visual>
      <origin xyz="${L3/2.0} 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="${r}" length="${L3}"/>
      </geometry>
      <material name="wood"/>
    </visual>
    <collision>
      <origin xyz="${L3/2.0} 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="${r}" length="${L3}"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder_x mass="0.05" radius="${r}" length="${L3}"/>
  </link>

  <!-- Wrist / gripper support along +X -->
  <link name="link4">
    <visual>
      <origin xyz="${L4/2.0} 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="${r}" length="${L4}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="${L4/2.0} 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="${r}" length="${L4}"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder_x mass="0.03" radius="${r}" length="${L4}"/>
  </link>

  <!-- Gripper base -->
  <link name="link5">
    <visual>
      <origin xyz="0.015 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.030 0.025"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0.015 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.030 0.025"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.03" x="0.030" y="0.030" z="0.025"/>
  </link>

  <!-- Moving gripper finger / virtual gripper joint -->
  <link name="link6">
    <visual>
      <origin xyz="0.025 0.020 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.050 0.008 0.012"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0.025 0.020 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.050 0.008 0.012"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.01" x="0.050" y="0.008" z="0.012"/>
  </link>

  <link name="link6_right">
    <visual>
        <origin xyz="0.025 0 0" rpy="0 0 0"/>
        <geometry>
        <box size="0.050 0.008 0.012"/>
        </geometry>
        <material name="red"/>
    </visual>
    <collision>
        <origin xyz="0.025 0 0" rpy="0 0 0"/>
        <geometry>
        <box size="0.050 0.008 0.012"/>
        </geometry>
    </collision>
    <xacro:inertial_box mass="0.01" x="0.050" y="0.008" z="0.012"/>
  </link>

  <!-- Tool frame -->
  <link name="tool">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
        <geometry>
            <sphere radius="0.008"/>
        </geometry>
    </collision>
  </link>

  <!-- =========================
       Joints
       ========================= -->

  <!-- joint1: base yaw -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 $(arg base_z)" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0"/>
  </joint>

  <!-- joint2: shoulder pitch. No PUMA lateral offset d3 -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 ${L1}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0"/>
  </joint>

  <!-- joint3: elbow pitch -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="${L2} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0"/>
  </joint>

  <!-- joint4: wrist pitch, different from PUMA wrist roll -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="${L3} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0"/>
  </joint>

  <!-- joint5: wrist / gripper orientation roll -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="${L4} 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0"/>
  </joint>

  <!-- joint6: gripper open-close, kept revolute to match SG90 servo command -->
  <joint name="joint6" type="prismatic">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0.030 0.010 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.015" effort="1.0" velocity="0.05"/>
  </joint>
  <joint name="joint6_right" type="fixed">
    <parent link="link5"/>
    <child link="link6_right"/>
    <origin xyz="0.030 -0.010 0" rpy="0 0 0"/>
  </joint>

  <joint name="link5_to_tool" type="fixed">
    <parent link="link5"/>
    <child link="tool"/>
    <origin xyz="$(arg tool_x) 0 0" rpy="0 0 0"/>
  </joint>

  <!-- =========================
       ros2_control
       ========================= -->

  <ros2_control name="MyArmMecanumSystem" type="system">
    <hardware>
      <plugin>$(arg hardware_plugin)</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <xacro:if value="$(arg use_gazebo_plugin)">
    <gazebo>
        <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin"
                filename="gz_ros2_control-system">
        <parameters>$(arg ros2_control_params)</parameters>
        </plugin>
    </gazebo>
  </xacro:if>

</robot>